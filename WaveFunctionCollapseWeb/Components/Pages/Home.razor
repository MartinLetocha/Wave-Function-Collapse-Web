@page "/"
@using Microsoft.AspNetCore.Mvc
@using WaveFunctionCollapseWeb.Algorithm
@using WaveFunctionCollapseWeb.Components.Display
@using WaveFunctionCollapseWeb.Data
@rendermode InteractiveServer
<PageTitle>Wave function collapse</PageTitle>

<div class="home font-equalizer">
    <div>
        <TileMap displayWidth="50" displayHeight="50"></TileMap>
        <div style="width: 50vh; display: flex; flex-direction: column; gap: 0.3rem; margin-top: 0.6rem">
            <div class="templates setting"><span class="tooltipmain">Templates:<div class="tooltiptext">This picks some pre-generated inputs as input.</div></span>
                <select class="" value=@DataManager.settings[2] @onchange="args => { DataManager.InvokeSettingsChangeEvent(2, args.Value);}">
                    <option>None</option>
                    <option>City</option>
                    <option>Forest</option>
                    <option>Plains</option>
                </select>
            </div>
            <div class="palette setting"><span class="tooltipmain">Palette:<div class="tooltiptext">Click the square to make that the painting tile, you can set this in the Overview page.</div></span>
                @for (var index = 0; index < DataManager.tilePalette.Length; index++)
                {
                    var id = DataManager.tilePalette[index];
                    var tile = DataManager.GetTileFromDb(id);
                    if (tile.Image.Data == null)
                    {
                        <span>@(index + 1)</span>
                        <div class="cell" @onclick="() => { paletteClick(id);}"
                             style="background: @tile.Background; color: @tile.TextColor; width: 2rem; height: 2rem; border: @(id == DataManager.paintingTile.ID ? 2 : 0)px red solid">
                            @tile.Text
                        </div>
                    }
                    else
                    {
                        <span>@(index + 1)</span>
                        <div class="cell" @onclick="() => { paletteClick(id);}"
                             style="color: @tile.TextColor; width: 2rem; height: 2rem; border: @(id == DataManager.paintingTile.ID ? 2 : 0)px red solid">
                            <img src="TileImage?id=@tile.ID" loading="lazy"
                                 decoding="async" width="100%" height="100%"
                                 draggable="false"
                                 ondragstart="return false;"/><span>@tile.Text</span>
                        </div>
                    }
                }
            </div>
            <div class="setting"><span class="tooltipmain">Use Input:<div class="tooltiptext">This decides whether to use input or not.</div></span>
                <input class="better-checkbox" type="checkbox" checked value=@DataManager.settings[3] @onchange="args => { DataManager.InvokeSettingsChangeEvent(3, args.Value);}">
            </div>
            <div class="setting"><span class="tooltipmain">Biomes:<div class="tooltiptext">This enables generation according to 'biomes'.</div></span><input
                                                                                                                                                          class="better-checkbox" type="checkbox" value=@DataManager.settings[4] @onchange="args => { DataManager.InvokeSettingsChangeEvent(4, args.Value);}">
            </div>
            <div class="setting"><span class="tooltipmain">Tile instructions:<div class="tooltiptext">This picks how the algorithm treats tile instructions.<br/>Directional -> Each tile takes in the information based off of the locations of other tiles to it.<br/>Tile by tile -> Each tile has information on what tiles can be next to it.<br/>Weight -> Each tile has chances of a tile appearing next to it.</div>
                </span>
                <select class="" value=@DataManager.settings[5] @onchange="args => { DataManager.InvokeSettingsChangeEvent(5, args.Value); }">
                    <option>Tile by tile</option>
                    <option>Directional</option>
                    <option>Weight</option>
                </select></div>
            <div class="setting"><span class="tooltipmain">Collapse:<div class="tooltiptext">This chooses how the collapse happens.<br/>Random -> It gets chosen by random.<br/>Sequential -> It gets chosen row by row.<br/>Entropy -> The lowest entropy gets collapsed, if there's multiple of the same, it picks randomly.</div>
                </span>
                <select class="" value=@DataManager.settings[6] @onchange="args => { DataManager.InvokeSettingsChangeEvent(6, args.Value); }">
                    <option>Entropy</option>
                    <option>Random</option>
                    <option>Sequential</option>
                </select>
            </div>
            <div class="setting">
                <span class="tooltipmain">Generation speed:
                    <div class="tooltiptext">Handles how fast the map generates, the speed is in tiles per second.</div>
                </span>
                <span style="gap: 0.6rem;display: flex;align-items: center;">Max 
                    <input type="checkbox" checked id="checkbox_speed" class=better-checkbox value=@DataManager.settings[7] @onchange="args => { DataManager.InvokeSettingsChangeEvent(7, args.Value); }">
                    <input disabled id="input_speed" type="number" max="400" min="1" value=@DataManager.settings[8] @onchange="args => { DataManager.InvokeSettingsChangeEvent(8, args.Value); }" step="1"
                           style="text-align: right"/>
                </span>
            </div>
            <div class="setting">
                <span class="tooltipmain">Seed:<div class="tooltiptext">The seed for the map generation.</div>
                </span>
                <input id="seed" type="text" style="text-align: right" value=@DataManager.settings[9] @oninput="args => { DataManager.InvokeSettingsChangeEvent(9, args.Value); }">
            </div>
            <div class="center-button">
                <div class="tooltipmain">
                    <button class="" @onclick="regenerateClick">Regenerate</button>
                    <div class="tooltiptext">This creates the map anew.</div>
                </div>
            </div>
        </div>
    </div>
    <div class="slider-map">
        <TileMapDisplay displayWidth="91" displayHeight="91"></TileMapDisplay>
        <input type="range" class="slider" min="1" max="100" value=@DataManager.settings[10] @oninput="args => { DataManager.InvokeSettingsChangeEvent(10, args.Value); }"/>
    </div>
</div>

<script>
    document.getElementById('checkbox_speed').onchange = function () {
        document.getElementById('input_speed').disabled = this.checked;
    }
</script>

@code {

    protected override void OnInitialized()
    {
        DataManager.Start();
    }

    private void regenerateClick()
    {
        WFCCore.Generate();
    }

    private void paletteClick(Guid id)
    {
        DataManager.paintingTile = DataManager.GetTileFromDb(id);
    }

}
